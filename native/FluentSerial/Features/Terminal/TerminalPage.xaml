<UserControl x:Class="FluentSerial.Features.TerminalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="ConnectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FormLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="串口终端" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="HeaderStatusText" Margin="0,4,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshPortsButton" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="RefreshPorts_Click" ToolTip="重新枚举串口设备">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE72C;" VerticalAlignment="Center" />
                        <TextBlock Text="刷新端口" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButtonStyle}" MinWidth="108"
                        Click="ConnectButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ConnectButtonGlyph" FontFamily="Segoe Fluent Icons" FontSize="13"
                                   Text="&#xE768;" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectButtonLabel" Text="打开串口" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Common parameters stay visible; advanced settings are expandable. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="122" />
                        <ColumnDefinition Width="138" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="串口设备" Style="{StaticResource ConnectionLabelStyle}" />
                        <ComboBox x:Name="PortBox" Style="{StaticResource InputComboBoxStyle}" MinHeight="32" AutomationProperties.Name="串口设备" SelectionChanged="PortBox_SelectionChanged">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="波特率" Style="{StaticResource ConnectionLabelStyle}" />
                        <ComboBox x:Name="BaudBox" Style="{StaticResource EditableComboBoxStyle}" MinHeight="32" IsTextSearchEnabled="False" AutomationProperties.Name="波特率" ToolTip="支持自定义，范围 1–4000000" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="字符编码" Style="{StaticResource ConnectionLabelStyle}" />
                        <ComboBox x:Name="EncodingBox" Style="{StaticResource InputComboBoxStyle}" MinHeight="32" SelectionChanged="EncodingBox_SelectionChanged" AutomationProperties.Name="字符编码" />
                    </StackPanel>
                    <Button x:Name="AdvancedButton" Grid.Column="3" Content="高级参数 ▾" VerticalAlignment="Bottom" Style="{StaticResource SubtleButtonStyle}" Click="Advanced_Click" />
                </Grid>
                <WrapPanel x:Name="AdvancedPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Width="78" Margin="0,0,12,6">
                        <TextBlock Text="数据位" Style="{StaticResource ConnectionLabelStyle}" />
                        <ComboBox x:Name="DataBitsBox" Style="{StaticResource InputComboBoxStyle}" MinHeight="32" AutomationProperties.Name="数据位" />
                    </StackPanel>
                    <StackPanel Width="108" Margin="0,0,12,6">
                        <TextBlock Text="校验" Style="{StaticResource ConnectionLabelStyle}" />
                        <ComboBox x:Name="ParityBox" Style="{StaticResource InputComboBoxStyle}" MinHeight="32" AutomationProperties.Name="校验" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,12,6">
                        <TextBlock Text="停止位" Style="{StaticResource ConnectionLabelStyle}" />
                        <ComboBox x:Name="StopBitsBox" Style="{StaticResource InputComboBoxStyle}" MinHeight="32" AutomationProperties.Name="停止位" />
                    </StackPanel>
                    <StackPanel Width="145" Margin="0,0,12,6">
                        <TextBlock Text="流控" Style="{StaticResource ConnectionLabelStyle}" />
                        <ComboBox x:Name="HandshakeBox" Style="{StaticResource InputComboBoxStyle}" MinHeight="32" SelectionChanged="Handshake_Changed" AutomationProperties.Name="流控" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Height="53" Margin="0,0,0,6">
                        <CheckBox MinWidth="0" x:Name="DtrCheck" Content="DTR" Margin="0,20,12,0" VerticalAlignment="Center" Checked="DtrRts_Changed" Unchecked="DtrRts_Changed" />
                        <CheckBox MinWidth="0" x:Name="RtsCheck" Content="RTS" Margin="0,20,8,0" VerticalAlignment="Center" Checked="DtrRts_Changed" Unchecked="DtrRts_Changed" />
                        <Button x:Name="BreakButton" Content="发送 Break" Style="{StaticResource SubtleButtonStyle}" Margin="0,20,0,0" Click="Break_Click" ToolTip="拉低 TX 约 200 毫秒" />
                    </StackPanel>
                </WrapPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PortHintText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ResetCountersButton" Grid.Column="1" Content="重置计数" Style="{StaticResource LinkButtonStyle}" Margin="8,0" Click="ResetCounters_Click" ToolTip="重置显示计数，会话累计记录保留" />
                    <Button x:Name="AutoReconnectHintButton" Grid.Column="2" Content="体验 DEMO 回环 →" Style="{StaticResource LinkButtonStyle}" Click="UseDemo_Click" />
                </Grid>
                <TextBlock x:Name="ConnectionErrorText" Margin="0,6,0,0" Foreground="{DynamicResource AppDangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- Receive console -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource AppTerminalBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0.5" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource AppTerminalBarBrush}" CornerRadius="10,10,0,0"
                        Padding="13,7,10,7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,7">
                            <Ellipse x:Name="ConsoleDot" Width="7" Height="7" Fill="{DynamicResource ConsoleMetaBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="ConsoleTitle" Text="未连接" Margin="8,0,0,0"
                                       Foreground="{DynamicResource AppTerminalTextBrush}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ConsoleMeta" Margin="10,0,0,0"
                                       Foreground="{DynamicResource ConsoleMetaBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1">
                            <CheckBox x:Name="AutoScrollCheck" Content="跟随最新" Style="{StaticResource ConsoleCheckBoxStyle}" IsChecked="True" Click="AutoScroll_Click" Margin="0,0,14,0" />
                            <CheckBox x:Name="TimestampCheck" Content="时间戳" Style="{StaticResource ConsoleCheckBoxStyle}"
                                      IsChecked="True" Click="DisplayOption_Click" />
                            <CheckBox x:Name="ShowTxCheck" Content="显示发送" Style="{StaticResource ConsoleCheckBoxStyle}"
                                      Margin="14,0,0,0" IsChecked="True" Click="DisplayOption_Click" />
                            <Border Style="{StaticResource ConsoleSegmentContainerStyle}" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RxTextRadio" Content="文本" GroupName="RxDisplayMode"
                                                 Style="{StaticResource ConsoleSegmentRadioStyle}" IsChecked="True"
                                                 Checked="RxMode_Checked" />
                                    <RadioButton x:Name="RxHexRadio" Content="HEX" GroupName="RxDisplayMode"
                                                 Style="{StaticResource ConsoleSegmentRadioStyle}"
                                                 Checked="RxMode_Checked" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="PauseButton" Content="暂停" Style="{StaticResource ConsoleButtonStyle}"
                                    Margin="16,0,0,0" Click="Pause_Click" />
                            <Button Content="清空" Style="{StaticResource ConsoleButtonStyle}" Margin="6,0,0,0"
                                    Click="ClearConsole_Click" />
                            <Button Content="保存" Style="{StaticResource ConsoleButtonStyle}" Margin="6,0,0,0"
                                    Click="SaveConsole_Click" />
                            <Button Content="复制" Style="{StaticResource ConsoleButtonStyle}" Margin="6,0,0,0"
                                    Click="CopyConsole_Click" />
                            <Button Content="查找" Style="{StaticResource ConsoleButtonStyle}" Margin="6,0,0,0" Click="FindConsole_Click" ToolTip="查找控制台 (Ctrl+F)" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="SearchBar" Grid.Row="1" Background="{DynamicResource AppTerminalBarBrush}" Padding="12,4,12,8" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ConsoleSearchBox" Style="{StaticResource InputTextBoxStyle}" AutomationProperties.Name="查找控制台" TextChanged="ConsoleSearch_TextChanged" PreviewKeyDown="ConsoleSearch_PreviewKeyDown" ToolTip="Enter 下一个，Shift+Enter 上一个" />
                        <TextBlock x:Name="SearchResultText" Grid.Column="1" Foreground="{DynamicResource ConsoleMetaBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="上一个" Style="{StaticResource ConsoleButtonStyle}" Click="FindPrevious_Click" />
                            <Button Content="下一个" Style="{StaticResource ConsoleButtonStyle}" Click="FindNext_Click" />
                            <Button Content="关闭" Style="{StaticResource ConsoleButtonStyle}" Click="CloseSearch_Click" ToolTip="Esc" />
                        </StackPanel>
                    </Grid>
                </Border>
                <RichTextBox x:Name="ConsoleBox" Grid.Row="2" AutomationProperties.Name="接收控制台" Style="{StaticResource ConsoleRichTextBoxStyle}"
                             Background="{DynamicResource AppTerminalBrush}" BorderThickness="0"
                             PreviewKeyDown="Console_PreviewKeyDown">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制选中内容" Click="CopySelection_Click" />
                            <MenuItem Header="复制全部" Click="CopyConsole_Click" />
                            <MenuItem Header="全选" Click="SelectAll_Click" />
                            <Separator />
                            <MenuItem Header="清空控制台" Click="ClearConsole_Click" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>

                <Grid x:Name="EmptyState" Grid.Row="2" Margin="1,0,1,8" Background="{DynamicResource AppTerminalBrush}" SizeChanged="EmptyState_SizeChanged">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock HorizontalAlignment="Center" Text="准备好连接你的设备"
                                   Foreground="{DynamicResource AppTerminalTextBrush}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyDescription" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Text="选择串口参数后打开端口开始收发。没有硬件时可以使用内置 DEMO 回环体验完整功能。"
                                   Foreground="{DynamicResource ConsoleMetaBrush}" FontSize="12" TextAlignment="Center" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="使用 DEMO 回环" Style="{StaticResource ConsoleSecondaryButtonStyle}"
                                    Click="UseDemo_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Send panel -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="14,10,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="发送" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SegmentContainerStyle}" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TxTextRadio" Content="文本" GroupName="TxSendMode"
                                             Style="{StaticResource SegmentRadioStyle}" IsChecked="True"
                                             Checked="TxMode_Checked" />
                                <RadioButton x:Name="TxHexRadio" Content="HEX" GroupName="TxSendMode"
                                             Style="{StaticResource SegmentRadioStyle}" Checked="TxMode_Checked" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="行尾" Style="{StaticResource CaptionTextStyle}" Margin="16,0,6,0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="EndingBox" Style="{StaticResource InputComboBoxStyle}" Width="80" SelectionChanged="SendOption_Changed" AutomationProperties.Name="发送行尾" />
                        <TextBlock Text="校验" Style="{StaticResource CaptionTextStyle}" Margin="12,0,6,0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ChecksumBox" Style="{StaticResource InputComboBoxStyle}" Width="134" SelectionChanged="SendOption_Changed" AutomationProperties.Name="发送校验" />
                        <CheckBox MinWidth="0" x:Name="EscapeCheck" Content="转义" Margin="14,0,0,0" VerticalAlignment="Center"
                                  IsChecked="True" Click="EscapeCheck_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,4,0,4">
                        <CheckBox MinWidth="0" x:Name="AutoSendCheck" Content="定时" VerticalAlignment="Center"
                                  Checked="AutoSend_Changed" Unchecked="AutoSend_Changed" />
                        <TextBox x:Name="AutoSendIntervalBox" Style="{StaticResource InputTextBoxStyle}" Width="58"
                                 Height="28" MinHeight="28" Padding="6,2" Margin="8,0,0,0" Text="1000" />
                        <TextBlock Text="ms" Style="{StaticResource CaptionTextStyle}" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                        <Button x:Name="HistoryButton" Style="{StaticResource IconButtonStyle}" Content="&#xE81C;"
                                Margin="10,0,0,0" ToolTip="发送历史" Click="History_Click" />
                    </StackPanel>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="14,8,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBox x:Name="SendBox" Style="{StaticResource InputTextBoxStyle}" Height="64" MinHeight="64" AutomationProperties.Name="发送内容"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" Padding="10,7"
                                 FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12.5"
                                 TextChanged="SendBox_TextChanged"
                                 PreviewKeyDown="SendBox_PreviewKeyDown" />
                        <TextBlock x:Name="SendPreviewText" Margin="2,5,0,0" Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="实际发送字节，包含校验与行尾" />
                        <TextBlock x:Name="SendHintText" Margin="2,5,0,0" Style="{StaticResource CaptionTextStyle}"
                                   Text="Ctrl+Enter 发送，支持 \r \n \t \xNN 转义" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Button x:Name="SendButton" Style="{StaticResource PrimaryButtonStyle}" Height="36" Click="Send_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE768;" VerticalAlignment="Center" />
                                <TextBlock Text="发送" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SendFileButton" Content="发送文件" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,7,0,0" Height="31" Click="SendFile_Click" />
                        <TextBlock x:Name="SendSizeText" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Style="{StaticResource CaptionTextStyle}" Text="0 B" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="14,8,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="快捷指令" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                    <ScrollViewer Grid.Column="1" Margin="12,0,8,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="48">
                        <WrapPanel x:Name="QuickCommandPanel" VerticalAlignment="Center" />
                    </ScrollViewer>
                    <Button Grid.Column="2" Content="管理" Style="{StaticResource LinkButtonStyle}"
                            VerticalAlignment="Center" Click="ManageCommands_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="4" Margin="2,8,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource AppTextTertiaryBrush}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="未连接串口" Margin="8,0,0,0"
                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="RecordingText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                           Margin="0,0,16,0" Visibility="Collapsed" />
                <TextBlock x:Name="CounterText" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                           Text="RX 0 B    TX 0 B    0 B/s" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
