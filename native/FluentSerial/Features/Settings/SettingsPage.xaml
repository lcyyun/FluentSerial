<UserControl x:Class="FluentSerial.Features.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Style="{StaticResource CaptionTextStyle}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DiscardButton" Content="撤销修改" Style="{StaticResource SubtleButtonStyle}"
                        Margin="0,0,8,0" IsEnabled="False" Click="Discard_Click" />
                <Button Content="恢复默认" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Click="RestoreDefaults_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Width="88" Click="Save_Click" ToolTip="保存设置 (Ctrl+S)" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                <!-- Appearance -->
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="主题" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox x:Name="ThemeBox" Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="控制台字号" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="FontSizeBox" Style="{StaticResource InputTextBoxStyle}" ToolTip="9–24，可输入小数" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="控制台字体" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="FontFamilyBox" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Text="Cascadia Mono / Consolas / Microsoft YaHei UI 均可使用"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Receive -->
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="接收" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="默认字符编码" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox x:Name="EncodingBox" Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="默认显示模式" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox x:Name="ReceiveModeBox" Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="控制台最大行数" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="MaxLinesBox" Style="{StaticResource InputTextBoxStyle}" ToolTip="200–20000 行，超出后移除最早的数据" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="ShowTimestampCheck" Grid.Row="0" Grid.Column="0"
                                      Content="接收数据前显示毫秒级时间戳" Margin="0,0,12,9" />
                            <CheckBox x:Name="ShowTxCheck" Grid.Row="0" Grid.Column="1"
                                      Content="在接收区显示本机发送的数据" Margin="0,0,0,9" />
                            <CheckBox x:Name="AutoScrollCheck" Grid.Row="1" Grid.Column="0"
                                      Content="有新数据时自动滚动到底部" Margin="0,0,12,0" />
                            <CheckBox x:Name="ConfirmClearCheck" Grid.Row="1" Grid.Column="1"
                                      Content="清空接收区前要求确认" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Send -->
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="发送" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="默认行尾" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox x:Name="EndingBox" Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="默认校验" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox x:Name="ChecksumBox" Style="{StaticResource InputComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="定时发送间隔（ms）" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="AutoSendIntervalBox" Style="{StaticResource InputTextBoxStyle}" ToolTip="50–60000 毫秒" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="UseEscapesCheck" Content="文本模式启用 \r \n \t \xNN 转义序列" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <!-- Data -->
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="数据" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="AutoRecordCheck" Content="打开串口时自动记录收发数据到本地日志" Margin="0,14,0,0" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DataPathText" VerticalAlignment="Center" FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <Button Grid.Column="1" Content="打开数据目录" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Click="OpenData_Click" />
                            <Button Grid.Column="2" Content="打开记录目录" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="4,0,0,0" Click="OpenLogs_Click" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Text="所有配置、快捷指令和会话记录仅保存在本机，不会上传。"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="FluentSerial 1.0" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text=".NET 10 + WPF + WPF-UI + System.IO.Ports" Margin="0,4,0,0"
                                       Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="原生 Windows 串口调试工作台：没有浏览器内核，没有 Electron 外壳。"
                                       Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="没有串口硬件时，可使用内置 DEMO 回环端口完整体验收发、校验和记录功能。"
                                       Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
