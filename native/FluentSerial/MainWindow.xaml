<ui:FluentWindow x:Class="FluentSerial.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FluentSerial"
                 Icon="Assets/app.ico"
                 Width="1280"
                 Height="820"
                 MinWidth="1080"
                 MinHeight="740"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource AppBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                 TextOptions.TextFormattingMode="Display"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FluentSerial" Background="{DynamicResource AppTitlebarBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AppBackgroundAltBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0.5,0">
                <Grid Margin="12,16,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="SidebarConnectButton" Grid.Row="0" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="2,0,2,18" HorizontalContentAlignment="Center" Click="SidebarConnect_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SidebarConnectGlyph" FontFamily="Segoe Fluent Icons" FontSize="13"
                                       Text="&#xE768;" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarConnectLabel" Text="打开串口" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Row="1">
                        <TextBlock Margin="9,0,0,5" Text="工作区" Style="{StaticResource CaptionTextStyle}" />
                        <ListBox x:Name="NavList" Style="{StaticResource NavListBoxStyle}" SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="terminal">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE756;" />
                                    <TextBlock Text="串口终端" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="presets">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE8F1;" />
                                    <TextBlock Text="端口预设" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="snippets">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE943;" />
                                    <TextBlock Text="快捷指令" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Margin="9,16,0,5" Text="工具" Style="{StaticResource CaptionTextStyle}" />
                        <ListBox x:Name="ToolNavList" Style="{StaticResource NavListBoxStyle}" SelectionChanged="ToolNavList_SelectionChanged">
                            <ListBoxItem Tag="logs">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Width="23" VerticalAlignment="Center" Text="&#xE8A5;" />
                                    <TextBlock Text="数据记录" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Border Style="{StaticResource HairlineStyle}" Margin="7,0,7,12" />
                        <Button x:Name="SidebarStatusButton" Style="{StaticResource SubtleButtonStyle}"
                                HorizontalContentAlignment="Stretch" Padding="8,4" Click="SidebarStatus_Click"
                                ToolTip="打开串口终端">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SidebarStatusDot" Width="6" Height="6" Fill="{DynamicResource AppTextTertiaryBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="SidebarStatusText" Text="未连接串口" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="ThemeButton" Style="{StaticResource CircleIconButtonStyle}"
                                    Click="ToggleTheme_Click" ToolTip="切换到深色模式"
                                    AutomationProperties.Name="切换深浅色主题">
                                <TextBlock x:Name="ThemeGlyph" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE708;" />
                            </Button>
                            <Button x:Name="ShortcutsButton" Style="{StaticResource CircleIconButtonStyle}"
                                    Click="Shortcuts_Click" ToolTip="键盘快捷键" AutomationProperties.Name="键盘快捷键">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE765;" />
                            </Button>
                            <Button x:Name="SettingsButton" Style="{StaticResource CircleIconButtonStyle}"
                                    Click="Settings_Click" ToolTip="设置" AutomationProperties.Name="设置">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE713;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</ui:FluentWindow>
