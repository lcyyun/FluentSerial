<Window x:Class="FluentSerial.Dialogs.PresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建预设"
        Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Editable variant of InputComboBoxStyle: the shared template has no PART_EditableTextBox. -->
        <Style x:Key="EditableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="10,0,4,0"
                                         Background="Transparent" BorderThickness="0" FontSize="13"
                                         Foreground="{DynamicResource AppTextBrush}"
                                         CaretBrush="{DynamicResource AppTextBrush}"
                                         SelectionBrush="{DynamicResource AppAccentBrush}"
                                         VerticalContentAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="10,0,4,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <ToggleButton x:Name="DropDownToggle" Grid.Column="1" Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12"
                                                           Text="&#xE70D;" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   PopupAnimation="Fade" StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource AppSurfaceBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0.5" CornerRadius="8" Padding="4">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush"
                                        Value="{DynamicResource AppBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,7" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border" Background="Transparent" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                    Value="{DynamicResource AppSurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                    Value="{DynamicResource AppSelectedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="DialogTitle" Text="新建预设" Style="{StaticResource PageTitleStyle}" />
            <CheckBox x:Name="FavoriteCheck" Content="收藏" Margin="18,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="名称" Style="{StaticResource FormLabelStyle}" />
                <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="端口" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="PortBox" Style="{StaticResource InputComboBoxStyle}" />
            </StackPanel>
            <Button x:Name="RefreshPortsButton" Grid.Column="4" Content="&#xE72C;"
                    Style="{StaticResource IconButtonStyle}" Height="32" Width="32"
                    VerticalAlignment="Bottom" ToolTip="刷新串口列表" Click="RefreshPorts_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="波特率" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="BaudBox" Style="{StaticResource EditableComboBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="数据位" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="DataBitsBox" Style="{StaticResource InputComboBoxStyle}">
                    <ComboBoxItem Content="5" Tag="5" />
                    <ComboBoxItem Content="6" Tag="6" />
                    <ComboBoxItem Content="7" Tag="7" />
                    <ComboBoxItem Content="8" Tag="8" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="校验" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="ParityBox" Style="{StaticResource InputComboBoxStyle}">
                    <ComboBoxItem Content="无校验" Tag="None" />
                    <ComboBoxItem Content="奇校验" Tag="Odd" />
                    <ComboBoxItem Content="偶校验" Tag="Even" />
                    <ComboBoxItem Content="标记" Tag="Mark" />
                    <ComboBoxItem Content="空号" Tag="Space" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="停止位" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="StopBitsBox" Style="{StaticResource InputComboBoxStyle}">
                    <ComboBoxItem Content="1 位" Tag="One" />
                    <ComboBoxItem Content="1.5 位" Tag="OnePointFive" />
                    <ComboBoxItem Content="2 位" Tag="Two" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="流控" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="FlowBox" Style="{StaticResource InputComboBoxStyle}">
                    <ComboBoxItem Content="无流控" Tag="None" />
                    <ComboBoxItem Content="硬件 RTS/CTS" Tag="RequestToSend" />
                    <ComboBoxItem Content="软件 XON/XOFF" Tag="XOnXOff" />
                    <ComboBoxItem Content="硬件 + 软件" Tag="RequestToSendXOnXOff" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,8">
                <CheckBox x:Name="DtrCheck" Content="DTR 就绪" IsChecked="True" />
                <CheckBox x:Name="RtsCheck" Content="RTS 就绪" IsChecked="True" Margin="22,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="接收模式" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="ReceiveModeBox" Style="{StaticResource InputComboBoxStyle}">
                    <ComboBoxItem Content="文本" Tag="Text" />
                    <ComboBoxItem Content="HEX" Tag="Hex" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="发送模式" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="SendModeBox" Style="{StaticResource InputComboBoxStyle}">
                    <ComboBoxItem Content="文本" Tag="Text" />
                    <ComboBoxItem Content="HEX" Tag="Hex" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="编码" Style="{StaticResource FormLabelStyle}" />
                <ComboBox x:Name="EncodingBox" Style="{StaticResource InputComboBoxStyle}">
                    <ComboBoxItem Content="UTF-8" Tag="utf-8" />
                    <ComboBoxItem Content="GBK" Tag="gbk" />
                    <ComboBoxItem Content="ASCII" Tag="ascii" />
                    <ComboBoxItem Content="Latin-1" Tag="iso-8859-1" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}" />
            <TextBox x:Name="NotesBox" Style="{StaticResource InputTextBoxStyle}" Height="64" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" />
        </StackPanel>

        <Border Grid.Row="6" Style="{StaticResource HairlineStyle}" Margin="0,18,0,16" />

        <TextBlock x:Name="ValidationText" Grid.Row="7" Foreground="{DynamicResource AppDangerBrush}" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Width="80" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
